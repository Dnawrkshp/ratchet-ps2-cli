<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;package-dist/**</DefaultItemExcludes>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmInitialHeapSize>268435456</WasmInitialHeapSize>
    <WasmBitcodeCompileOptimizationFlag>-O3</WasmBitcodeCompileOptimizationFlag>
    <EmccLinkOptimizationFlag>-O3</EmccLinkOptimizationFlag>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="wwwroot/**" />
    <Content Include="package.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ratchetps2-wasm.js" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ratchetps2-wasm.d.ts" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="README.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RatchetPs2.Core\RatchetPs2.Core.csproj" SetTargetFramework="TargetFramework=net9.0-browser" Targets="Build" GlobalPropertiesToRemove="_IsPublishing;PublishDir;_CommandLineDefinedOutputPath;DOTNET_CLI_DISABLE_PUBLISH_AND_PACK_RELEASE;WebPublishProfileFile" />
    <ProjectReference Include="..\RatchetPs2.Games.GC\RatchetPs2.Games.GC.csproj" SetTargetFramework="TargetFramework=net9.0-browser" Targets="Build" GlobalPropertiesToRemove="_IsPublishing;PublishDir;_CommandLineDefinedOutputPath;DOTNET_CLI_DISABLE_PUBLISH_AND_PACK_RELEASE;WebPublishProfileFile" />
    <ProjectReference Include="..\RatchetPs2.Games.DL\RatchetPs2.Games.DL.csproj" SetTargetFramework="TargetFramework=net9.0-browser" Targets="Build" GlobalPropertiesToRemove="_IsPublishing;PublishDir;_CommandLineDefinedOutputPath;DOTNET_CLI_DISABLE_PUBLISH_AND_PACK_RELEASE;WebPublishProfileFile" />
    <ProjectReference Include="..\RatchetPs2.Games.UYA\RatchetPs2.Games.UYA.csproj" SetTargetFramework="TargetFramework=net9.0-browser" Targets="Build" GlobalPropertiesToRemove="_IsPublishing;PublishDir;_CommandLineDefinedOutputPath;DOTNET_CLI_DISABLE_PUBLISH_AND_PACK_RELEASE;WebPublishProfileFile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.14" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PreparePackageLayout" AfterTargets="Publish">
    <PropertyGroup>
      <WasmPackageDir>$(PublishDir)package/</WasmPackageDir>
    </PropertyGroup>

    <RemoveDir Directories="$(WasmPackageDir)" />
    <MakeDir Directories="$(WasmPackageDir)_framework" />

    <ItemGroup>
      <PublishedFrameworkFiles Include="$(PublishDir)wwwroot/_framework/**/*" />
      <PackageSourceFiles Include="$(MSBuildProjectDirectory)/package.json;$(MSBuildProjectDirectory)/ratchetps2-wasm.js;$(MSBuildProjectDirectory)/ratchetps2-wasm.d.ts;$(MSBuildProjectDirectory)/README.md" />
    </ItemGroup>

    <Copy SourceFiles="@(PublishedFrameworkFiles)"
          DestinationFiles="@(PublishedFrameworkFiles->'$(WasmPackageDir)_framework/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(PackageSourceFiles)"
          DestinationFiles="@(PackageSourceFiles->'$(WasmPackageDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="GenerateWasmInterop" BeforeTargets="BeforeBuild" Condition="'$(_IsPublishing)' != 'true' and '$(WasmBuildingForNestedPublish)' != 'true'">
    <PropertyGroup>
      <WasmExportManifest>$(MSBuildProjectDirectory)/wasm-exports.json</WasmExportManifest>
      <GeneratedJsPath>$(MSBuildProjectDirectory)/ratchetps2-wasm.js</GeneratedJsPath>
      <GeneratedDtsPath>$(MSBuildProjectDirectory)/ratchetps2-wasm.d.ts</GeneratedDtsPath>
      <WasmInteropGeneratorProject>$(MSBuildProjectDirectory)/../RatchetPs2.Wasm.Generator/RatchetPs2.Wasm.Generator.csproj</WasmInteropGeneratorProject>
      <WasmInteropGeneratorDll>$(MSBuildProjectDirectory)/../RatchetPs2.Wasm.Generator/bin/$(Configuration)/net9.0/RatchetPs2.Wasm.Generator.dll</WasmInteropGeneratorDll>
    </PropertyGroup>

    <MSBuild Projects="$(WasmInteropGeneratorProject)" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net9.0" />
    <Exec Command="dotnet &quot;$(WasmInteropGeneratorDll)&quot; &quot;$(WasmExportManifest)&quot; &quot;$(GeneratedJsPath)&quot; &quot;$(GeneratedDtsPath)&quot;" />
  </Target>

</Project>
